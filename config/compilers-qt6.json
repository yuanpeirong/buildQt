    {
      "id": "msvc2022",
      "compiler_id": "msvc2022_64",
      "runner": "windows-2022",
      "needs_perl": false,
      "apply_libcpp_patches": false,
      "compiler": {
        "source": "runner",
        "url": "",
        "pkg_type": "",
        "extract_to": "",
        "path_bin": ""
      },
      "vcvars": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Enterprise\\VC\\Auxiliary\\Build\\vcvarsall.bat",
      "configure": {
        "full": {
          "pre": "-static -static-runtime -release",
          "post": "-nomake examples -nomake tests -skip qtwebengine -opensource -confirm-license -qt-libpng -qt-libjpeg -qt-zlib -qt-pcre -qt-freetype -qt-harfbuzz -qt-webp -qt-tiff -schannel -opengl desktop -platform win32-msvc"
        },
        "rp": {
          "pre": "-static -static-runtime -release -nomake examples",
          "post": "-opensource -confirm-license -qt-libpng -qt-libjpeg -qt-zlib -qt-pcre -qt-freetype -schannel -opengl desktop -platform win32-msvc"
        }
      }
    },
